<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground for VyPlay.

  The adaptive canvas is 108x108 dp and the launcher may mask it to a circle,
  squircle or rounded square, so all artwork stays inside the central 72x72 dp
  safe zone (an 18 dp inset on every side). The play glyph is therefore drawn
  between 38 and 70 on both axes, centred on (54, 54).

  White on the violet background declared in values/colors.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,36 L74,54 L40,72 Z" />
</vector>
